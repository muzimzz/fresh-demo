# 이 파일을 application-secret.yaml로 복사하고 실제 값을 채우세요.
# application-secret.yaml은 .gitignore에 등록되어 있어 커밋되지 않는다.
# 프로젝트 루트(이 파일과 같은 위치)에 두면 application.yaml의
# spring.config.import: optional:file:application-secret.yaml 로 자동 로드된다.
#
# 아래 값들은 application.yaml에서 ${환경변수:기본값} 형태로도 참조하고 있으므로,
# 이 파일 대신 환경변수로 주입해도 동일하게 동작한다(배포 환경은 보통 환경변수를 쓴다).
# 로컬 개발 중에는 이 파일 하나로 관리하는 편이 더 간단하다.

spring:
  datasource:
    username: root
    password: YOUR_MYSQL_PASSWORD

  security:
    oauth2:
      client:
        registration:
          kakao:
            # 카카오 developers > 내 애플리케이션 > 앱 키 > REST API 키
            client-id: YOUR_KAKAO_CLIENT_ID
            # 카카오 developers > 카카오 로그인 > 보안 > Client Secret
            client-secret: YOUR_KAKAO_CLIENT_SECRET

jwt:
  # HS256 서명에 쓰이는 키 — 최소 32바이트(256비트) 이상 랜덤 문자열 권장.
  # 예: openssl rand -base64 32
  secret: YOUR_JWT_SECRET_AT_LEAST_32_BYTES

# KakaoUnlinkClient(탈퇴 시 unlink), KakaoUnlinkWebhookController(app_id 검증)에서 사용
kakao:
  # 카카오 developers > 내 애플리케이션 > 앱 키 > 앱 ID (app_id 검증용, REST API 키와 다름)
  app-id: YOUR_KAKAO_APP_ID
  # 카카오 developers > 내 애플리케이션 > 보안 > Admin 키 — 절대 프론트/클라이언트에 노출 금지
  admin-key: YOUR_KAKAO_ADMIN_KEY
